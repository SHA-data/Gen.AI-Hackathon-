# Environment Configuration Template
ENV=dev
PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/neuralcfo
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=super-secret-hackathon-key-2026-very-secure-32bytes

# Backend Service Toggles (set to 'real' when integrating, or 'fake' for isolated local testing)
FINANCE_BACKEND=fake
MOONSHOT_BACKEND=fake
MEMORY_BACKEND=fake

# LLM & Model Selection
MODEL_NAME=nvidia/nemotron-3-super
FALLBACK_MODEL_NAME=nvidia/nemotron-3.5-lightning
OPENAI_API_KEY=
NVIDIA_API_KEY=
METERLESS_API_KEY=
